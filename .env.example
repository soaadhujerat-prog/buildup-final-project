# =============================================================================
# BuildUp – PUBLIC runtime configuration (Expo). PLACEHOLDERS ONLY.
# =============================================================================
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# `.env` is git-ignored. This file (`.env.example`) IS committed and must
# NEVER contain real values.
# =============================================================================

# Supabase project URL -> https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable key (format: sb_publishable_...). PUBLIC by design —
# safe to ship in the client bundle; access is governed by RLS on the server.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend master switch.
#   false (committed default) -> the app runs entirely on in-memory mock data.
#   true                      -> real Supabase Auth + Session + Profiles
#                                (Phase 2). Requires the `login-by-id` Edge
#                                Function to be deployed and its `ID_HMAC_PEPPER`
#                                secret set — see
#                                supabase/functions/login-by-id/README.md.
# Jobs / Staffing / Chat / Smart Match stay on mock data regardless until their
# own phases. There is NO silent fallback to mock when this is true: a backend
# error surfaces as a real error.
EXPO_PUBLIC_USE_BACKEND=false

# -----------------------------------------------------------------------------
# NOT stored here and NOT in Expo env — server-side secrets for later phases,
# configured ONLY as Supabase Edge Function secrets (never in the RN bundle):
#
#   SUPABASE_SERVICE_ROLE_KEY   privileged Edge Functions only
#   ID_HMAC_PEPPER              HMAC-SHA256 pepper for id_number hashing (#1)
#   OPENAI_API_KEY              Smart Match semantic pass (#7)
#   MAIL_API_KEY               transactional email (registration / support)
# -----------------------------------------------------------------------------
