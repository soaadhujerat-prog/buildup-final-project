# =============================================================================
# BuildUp – PUBLIC runtime configuration (Expo). PLACEHOLDERS ONLY.
# =============================================================================
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# `.env` is git-ignored. This file (`.env.example`) IS committed and must
# NEVER contain real values.
# =============================================================================

# Supabase project URL -> https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable key (format: sb_publishable_...). PUBLIC by design —
# safe to ship in the client bundle; access is governed by RLS on the server.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# NOT stored here and NOT in Expo env — server-side secrets, configured ONLY as
# Supabase Edge Function secrets (never in the RN bundle):
#
#   SUPABASE_SERVICE_ROLE_KEY   privileged Edge Functions only
#   ID_HMAC_PEPPER              HMAC-SHA256 pepper for id_number hashing
#   ID_ENC_KEY                  AES-256-GCM key for the id_number ciphertext
#   OPENAI_API_KEY              Smart Match semantic pass
#   RESEND_API_KEY              transactional email (registration / support)
# -----------------------------------------------------------------------------
